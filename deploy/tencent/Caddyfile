:80 {
  @www host www.innovateacademy.net
  redir @www https://innovateacademy.net{uri} 308
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: {$S3_CSP_ORIGIN}; font-src 'self'; media-src 'self' {$S3_CSP_ORIGIN}; connect-src 'self' {$S3_CSP_ORIGIN}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /health/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
