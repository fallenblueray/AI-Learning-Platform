NODE_ENV=production
PORT=3000
APP_URL=https://innovateacademy.net
DATABASE_URL=mysql://pt_app:URL_ENCODED_PASSWORD@mysql:3306/pt_academy
DB_SSL=false
MYSQL_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ISSUER_NAME=創科學苑 / Innovate Academy
DEMO_MODE=true
LIVE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
