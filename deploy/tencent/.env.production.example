S3_BUCKET=REPLACE_WITH_COS_BUCKET_NAME_WITH_APPID
S3_ACCESS_KEY=REPLACE_WITH_TENCENT_SECRET_ID
S3_SECRET_KEY=REPLACE_WITH_TENCENT_SECRET_KEY
S3_CSP_ORIGIN=https://*.cos.ap-singapore.myqcloud.com
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
